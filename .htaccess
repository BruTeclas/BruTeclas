# Regras do servidor (Hostinger: Apache/LiteSpeed) do site público nfcliente.com.br
# nfcliente.com.br/<link>  ->  perfil.html   ·   /admin  ->  admin.nfcliente.com.br (painel)
# O painel tem as próprias regras em painel-admin/.htaccess (no repositório: admin/.htaccess).

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sempre HTTPS e sem "www"
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Arquivos que não fazem parte do site publicado (inclui a pasta usada na publicação)
  RewriteRule (^|/)\.git(/|$) - [R=404,L]
  RewriteRule ^(_publicacao|publicar|supabase|ferramentas|docs|README\.md|vercel\.json|_redirects)(/|$) - [R=404,L]
  RewriteRule \.php$ - [R=404,L]

  # O painel mudou para admin.nfcliente.com.br. Links antigos e os dos e-mails de senha
  # (/admin/redefinir-senha.html?token_hash=...) continuam funcionando: vão para lá com os mesmos parâmetros.
  RewriteRule ^admin(?:/+(.*))?$ https://admin.nfcliente.com.br/$1 [L,R=301]

  # A pasta do painel não abre pelo endereço do site público
  RewriteCond %{HTTP_HOST} !^admin\. [NC]
  RewriteRule ^painel-admin(/|$) - [R=404,L]

  # Arquivos e pastas que existem são servidos normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer /<link-do-perfil> abre a página do perfil
  RewriteRule ^[a-z0-9-]{1,40}/?$ /perfil.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Só HTTPS por 1 ano, mesmo se alguém digitar http:// (protege o login em Wi-Fi público)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Lista do que o navegador pode carregar nas páginas públicas: scripts só deste site (sem login);
  # dados só da leitura do perfil no Supabase; fotos do Supabase; estilos e fontes do Google Fonts e do Font Awesome.
  # Nenhum formulário e nenhuma moldura (iframe). O painel tem uma lista própria (admin/.htaccess).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://vomhyqdvxhkovykipxpg.supabase.co; connect-src https://vomhyqdvxhkovykipxpg.supabase.co; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Sempre confere se há versão nova das páginas, estilos e scripts
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
