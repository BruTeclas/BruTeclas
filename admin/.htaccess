# Regras do painel: admin.nfcliente.com.br
# Esta pasta é publicada em public_html/painel-admin, que é a pasta do subdomínio na Hostinger.
# As regras do site público ficam no .htaccess da raiz.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Só abre pelo endereço do painel (nunca por nfcliente.com.br/painel-admin)
  RewriteCond %{HTTP_HOST} !^admin\.nfcliente\.com\.br$ [NC]
  RewriteRule ^ - [R=404,L]

  # Sempre HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://admin.nfcliente.com.br%{REQUEST_URI} [L,R=301]

  # Nada de PHP (como a página padrão da Hostinger) nem de arquivos ocultos
  RewriteRule (^|/)\. - [R=404,L]
  RewriteRule \.php$ - [R=404,L]

  # Endereços antigos (/admin/...), inclusive os links dos e-mails de senha: mesma página, sem o /admin.
  # Destino sempre com o endereço completo, para "/admin//outro-site" nunca levar a outro site.
  RewriteRule ^admin(?:/+(.*))?$ https://admin.nfcliente.com.br/$1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  # Lista do que o navegador pode carregar no painel: scripts só deste endereço (bibliotecas em /js/lib, versão fixa);
  # dados só do Supabase do projeto e da busca de CEP; estilos e fontes do Google Fonts e do Font Awesome.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://vomhyqdvxhkovykipxpg.supabase.co; connect-src 'self' https://vomhyqdvxhkovykipxpg.supabase.co https://viacep.com.br; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  # Sempre confere se há versão nova das páginas, estilos e scripts
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
