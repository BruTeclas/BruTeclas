# Regras da página do cliente: cliente.nfcliente.com.br
# Esta pasta é publicada em public_html/painel-cliente, que é a pasta do subdomínio na Hostinger.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Só abre pelo endereço da página do cliente
  RewriteCond %{HTTP_HOST} !^cliente\.nfcliente\.com\.br(:[0-9]+)?$ [NC]
  RewriteRule ^ - [R=404,L]

  # Sempre HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://cliente.nfcliente.com.br%{REQUEST_URI} [L,R=301]

  # Nada de PHP nem de arquivos ocultos (exceto a renovação do certificado HTTPS)
  RewriteRule (^|/)\.(?!well-known/acme-challenge/) - [R=404,L]
  RewriteRule \.php$ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  # Scripts só deste endereço; dados e fotos só do Supabase do projeto; nenhuma moldura (iframe)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://vomhyqdvxhkovykipxpg.supabase.co; connect-src https://vomhyqdvxhkovykipxpg.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
